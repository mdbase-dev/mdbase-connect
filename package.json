{
  "name": "mdbase-connect",
  "version": "0.1.0-beta.152",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:release-downloads": "node scripts/check-release-downloads.mjs",
    "test:release-downloads": "node --test scripts/check-release-downloads.test.mjs scripts/lib/prefetch-release.test.mjs apps/editor/scripts/native/authentication.test.mjs",
    "portal:review": "node apps/portal/tests/review/server.mjs",
    "test:portal-review": "playwright test --config apps/portal/playwright.config.ts",
    "build": "pnpm i18n:check && pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:mode-worker": "node scripts/check-mode-packages.mjs hosted-worker",
    "test:mode-sdk": "node scripts/check-mode-packages.mjs sdk",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:generated": "pnpm check:changes && pnpm check:problems && pnpm check:operations && pnpm check:capabilities && pnpm check:manifest-validators",
    "check:npm-bootstrap": "node scripts/check-npm-package-bootstrap.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check:release-components": "node scripts/release-components.mjs --check",
    "check:workspace-pins": "node scripts/check-workspace-pins.mjs",
    "check:vendored-sdk": "node scripts/check-vendored-sdk.mjs",
    "canary:hosted-read": "node scripts/hosted-read-canary.mjs",
    "canary:hosted-sync": "node scripts/hosted-sync-canary.mjs",
    "generate:changes": "node scripts/generate-change-events.mjs",
    "check:changes": "node scripts/generate-change-events.mjs --check",
    "generate:problems": "node scripts/generate-connect-problems.mjs",
    "check:problems": "node scripts/generate-connect-problems.mjs --check",
    "generate:operations": "node scripts/generate-operation-catalog.mjs",
    "check:operations": "node scripts/generate-operation-catalog.mjs --check",
    "generate:capabilities": "node scripts/generate-application-capabilities.mjs",
    "check:capabilities": "node scripts/generate-application-capabilities.mjs --check",
    "generate:manifest-validators": "node scripts/generate-manifest-validators.mjs",
    "check:manifest-validators": "node scripts/generate-manifest-validators.mjs --check",
    "audit:dependencies": "pnpm audit --audit-level high",
    "dev:environment:up": "node scripts/dev-environment.mjs up",
    "dev:environment:down": "node scripts/dev-environment.mjs down",
    "dev:environment:reset": "node scripts/dev-environment.mjs reset",
    "dev:onboarding": "node scripts/dev-environment.mjs onboarding",
    "dev:environment:status": "node scripts/dev-environment.mjs status",
    "dev:environment:logs": "node scripts/dev-environment.mjs logs",
    "dev:desktop:isolated": "node scripts/isolated-desktop.mjs",
    "dev:desktop:fresh": "node scripts/isolated-desktop.mjs --fresh",
    "deploy:dev": "node scripts/deploy-editor-dev.mjs",
    "deploy:lab": "node scripts/deploy-lab-local.mjs",
    "e2e": "node test/system/run.mjs --suite runtime-daemon",
    "e2e:container": "node test/system/run.mjs --suite container",
    "e2e:relay": "node test/system/run.mjs --suite relay",
    "package:audit": "pnpm build && node scripts/package-audit.mjs",
    "package:consumer": "node scripts/pack-consumer-sdk.mjs",
    "pretest": "pnpm build:packages",
    "test": "node --test scripts/app-timings/results.test.mjs scripts/performance-report.test.mjs scripts/deploy-editor-dev.test.mjs scripts/deploy-lab-local.test.mjs scripts/lib/*.test.mjs && pnpm --filter @mdbase/connect-desktop test && pnpm --filter '!@mdbase/connect-desktop' -r test",
    "test:release-trust": "pnpm --filter @mdbase-dev/connect-protocol build && node --test scripts/lib/release-trust-*.test.mjs",
    "test:fast": "pnpm test",
    "test:integration": "pnpm test:accessibility",
    "test:system": "node test/system/run.mjs",
    "test:all": "pnpm test:fast && pnpm test:integration && pnpm test:system",
    "test:accessibility": "pnpm build:packages && pnpm --filter @mdbase/connect-portal build && pnpm --filter @mdbase/connect-desktop build:renderer && pnpm --filter mdbase-editor build && node scripts/browser-accessibility.test.mjs && node --test apps/desktop/scripts/renderer-ux.test.mjs",
    "pretypecheck": "pnpm i18n:check && pnpm build:packages",
    "typecheck": "pnpm -r typecheck",
    "ci:local": "node scripts/ci-local.mjs",
    "version:check": "node scripts/check-release-version.mjs",
    "generate:icons": "node scripts/write-brand-icons.mjs",
    "i18n:check": "pnpm --filter @mdbase-dev/i18n build && pnpm --filter @mdbase-dev/ui i18n:check && pnpm --filter @mdbase/connect-ui i18n:check && pnpm --filter @mdbase/connect-portal i18n:check && pnpm --filter @mdbase/connect-desktop i18n:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "wrangler": "4.166.0"
  }
}
