{
  "name": "mdbase-connect",
  "version": "0.1.0-beta.59",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:npm-bootstrap": "node scripts/check-npm-package-bootstrap.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "generate:problems": "node scripts/generate-connect-problems.mjs",
    "check:problems": "node scripts/generate-connect-problems.mjs --check",
    "generate:operations": "node scripts/generate-operation-catalog.mjs",
    "check:operations": "node scripts/generate-operation-catalog.mjs --check",
    "audit:dependencies": "pnpm audit --audit-level high",
    "sync:runtime-contracts": "node scripts/sync-runtime-contracts.mjs",
    "dev:environment:up": "node scripts/dev-environment.mjs up",
    "dev:environment:down": "node scripts/dev-environment.mjs down",
    "dev:environment:reset": "node scripts/dev-environment.mjs reset",
    "dev:onboarding": "node scripts/dev-environment.mjs onboarding",
    "dev:environment:status": "node scripts/dev-environment.mjs status",
    "dev:environment:logs": "node scripts/dev-environment.mjs logs",
    "dev:desktop:isolated": "node scripts/isolated-desktop.mjs",
    "dev:desktop:fresh": "node scripts/isolated-desktop.mjs --fresh",
    "dev:desktop:staging": "node scripts/isolated-desktop.mjs --staging",
    "deploy:dev": "node scripts/deploy-editor-dev.mjs",
    "e2e": "node test/system/run.mjs --suite local",
    "e2e:container": "node test/system/run.mjs --suite container",
    "e2e:desktop:container": "node test/system/run.mjs --suite desktop",
    "e2e:ecosystem": "node test/system/run.mjs --suite container,desktop",
    "e2e:relay": "node test/system/run.mjs --suite relay",
    "e2e:sync": "node test/system/run.mjs --suite sync",
    "e2e:provider": "node test/system/run.mjs --suite provider",
    "e2e:files": "node test/system/run.mjs --suite files",
    "e2e:files:adversarial": "node test/system/run.mjs --suite files-adversarial",
    "e2e:authority:stress": "MDBASE_CONNECT_PROVIDER_E2E_PROMOTION_COUNT=2500 pnpm e2e:provider",
    "e2e:provider:stress": "MDBASE_CONNECT_PROVIDER_E2E_BULK_COUNT=10000 pnpm e2e:provider",
    "profile:mirror": "node --expose-gc scripts/mirror-profile.mjs",
    "profile:mirror:check": "pnpm --filter @mdbase-dev/connect-sync build && node scripts/assert-mirror-performance.mjs",
    "profile:mirror:vault": "pnpm --filter @mdbase-dev/connect-sync build && node scripts/mirror-live-vault.mjs",
    "profile:mirror:writable-vault": "pnpm --filter @mdbase-dev/connect-sync build && node scripts/mirror-writable-live-vault.mjs",
    "check:mirror:mobile": "pnpm --filter @mdbase-dev/connect-sync check:mobile",
    "package:audit": "pnpm build && node scripts/package-audit.mjs",
    "package:consumer": "node scripts/pack-consumer-sdk.mjs",
    "check:consumer-artifacts": "node scripts/check-consumer-artifacts.mjs",
    "profile:connect": "cargo run --release -p mdbase-cli -- profile connect",
    "profile:rs": "cargo run --release -p mdbase-cli -- profile engine --scenario queries",
    "profile:views:rs": "cargo run --release -p mdbase-cli -- profile engine --scenario views",
    "stress:prepare": "pnpm build:packages && pnpm --filter @mdbase/connect-server build",
    "stress:quick": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile quick",
    "stress:functional": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile functional",
    "stress:http": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile quick --transport http --seeds 5 --steps 200",
    "stress:scale": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile scale",
    "stress:soak": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile soak",
    "stress:soak:smoke": "pnpm stress:prepare && node scripts/stress/functional-stress.mjs --profile soak --duration 10s --steps 100000 --clients 4 --initial-records 8 --checkpoint-every 100 --mirror-every 250",
    "test:stress-regressions": "pnpm stress:prepare && node scripts/stress/replay-regressions.mjs",
    "pretest": "pnpm build:packages",
    "test": "node --test scripts/lib/*.test.mjs && pnpm --filter @mdbase/connect-desktop test && pnpm --filter '!@mdbase/connect-desktop' -r test",
    "test:fast": "pnpm test && node test/rust/run.mjs",
    "test:integration": "pnpm test:browser-storage && pnpm test:accessibility",
    "test:system": "node test/system/run.mjs",
    "test:all": "pnpm test:fast && pnpm test:integration && pnpm test:system",
    "test:accessibility": "pnpm build:packages && pnpm --filter @mdbase/connect-portal build && pnpm --filter @mdbase/connect-desktop build:renderer && pnpm --filter mdbase-editor build && node scripts/browser-accessibility.test.mjs",
    "test:browser-storage": "pnpm --filter @mdbase-dev/connect test:browser-storage",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r typecheck",
    "version:check": "node scripts/check-release-version.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
