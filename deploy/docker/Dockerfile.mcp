FROM node:24.22.1-bookworm-slim AS build

# Refresh the system trust store as well as Node's bundled CA store.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
# The workspace lock resolves file-pinned editor SDK bytes even for filtered installs.
COPY apps/editor/vendor/sdk-eaa4e697-production-beta141.tgz apps/editor/vendor/mdbase-dev-ui-dev-b2d7c464.tgz apps/editor/vendor/mdbase-dev-connect-protocol-0.1.0-beta.129-c280cd194ffd.tgz apps/editor/vendor/
COPY packages/protocol/package.json packages/protocol/package.json
COPY packages/client/package.json packages/client/package.json
COPY services/mcp/package.json services/mcp/package.json
# services/mcp and packages/app-ui share the vendored SDK tarball under packages/app-ui; frozen installs read it.
COPY packages/app-ui/vendor packages/app-ui/vendor

RUN pnpm install --frozen-lockfile --filter @mdbase/connect-mcp...
# Same-named vendored SDK builds can hoist over each other; fail unless MCP resolves its own.
COPY scripts/check-vendored-sdk.mjs scripts/check-vendored-sdk.mjs
RUN node scripts/check-vendored-sdk.mjs services/mcp

COPY packages/protocol packages/protocol
COPY packages/client packages/client
COPY services/mcp services/mcp

RUN pnpm --filter @mdbase-dev/connect-protocol build \
 && pnpm --filter @mdbase-dev/connect build \
 && pnpm --filter @mdbase/connect-mcp build

FROM node:24.22.1-bookworm-slim AS runtime

# Refresh the system trust store as well as Node's bundled CA store.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ARG MDBASE_CONNECT_REVISION
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8790 \
    MDBASE_CONNECT_REVISION=${MDBASE_CONNECT_REVISION} \
    RENDER_GIT_COMMIT=${MDBASE_CONNECT_REVISION}

WORKDIR /app
COPY --from=build /app /app

EXPOSE 8790
USER node
CMD ["node", "services/mcp/dist/index.js"]
