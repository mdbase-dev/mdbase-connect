# Deploy an immutable mdbase connect release checkout. This value labels the
# locally built images and must match the checked-out tag without the leading v.
MDBASE_CONNECT_VERSION=0.1.0-beta.2

CONNECT_PUBLIC_URL=https://connect.example.com
CONNECT_BIND_PORT=8787

# Production authentication. Create a GitHub OAuth app whose callback is
# https://connect.example.com/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USER_IDS=
REGISTRATION_MODE=closed

# Generate independent random values. Never commit the populated file.
CONTROL_DATABASE_PASSWORD=
RELAY_NATS_TOKEN=

# Set HOSTED_COLLECTIONS=1 and start the "hosted" Compose profile to operate
# hosted collections. The provider URL must be its externally reachable origin.
HOSTED_COLLECTIONS=0
HOSTED_PROVIDER_PUBLIC_URL=https://sync.example.com
HOSTED_PROVIDER_BIND_PORT=8790
HOSTED_DATABASE_PASSWORD=
HOSTED_PROVIDER_INTERNAL_TOKEN=
HOSTED_PROVIDER_MASTER_KEY=

# Start the "mcp" Compose profile to operate the optional remote MCP gateway.
MCP_PUBLIC_URL=https://mcp.example.com
MCP_BIND_PORT=8791
MCP_DATABASE_PASSWORD=
MCP_MASTER_KEY=
