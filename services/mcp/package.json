{
  "name": "@mdbase/connect-mcp",
  "version": "0.1.0-beta.152",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && pnpm build:view",
    "build:view": "vite build --config vite.view.config.ts",
    "dev": "pnpm build:view && tsx watch src/index.ts",
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "node ../../packages/app-ui/scripts/compile-catalogues.mjs ../../packages/app-ui && mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check --compose \"../../packages/app-ui/src/locales/{locale}/messages.json\"",
    "migrate": "node dist/migrate.js",
    "start": "node dist/index.js",
    "test": "pnpm i18n:compile && node ../../scripts/ci/vitest.mjs",
    "typecheck": "pnpm i18n:compile && tsc -p tsconfig.json --noEmit && tsc -p view/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@mdbase-dev/connect-protocol": "workspace:*",
    "@mdbase-dev/sdk": "file:../../apps/editor/vendor/sdk-12c8a3bb-production-0.2.47.tgz",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.7.2",
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@lingui/vite-plugin": "6.9.0",
    "@mdbase-dev/i18n": "workspace:*",
    "@mdbase-dev/ui": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  }
}
