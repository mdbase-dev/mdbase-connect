{
  "manifest_version": 1,
  "id": "dev.mdbase.editor",
  "name": "mdbase editor",
  "homepage": "https://editor.mdbase.dev/",
  "redirect_uris": [
    "https://editor.mdbase.dev/"
  ],
  "requirements": {
    "people": {
      "version": 1,
      "permissions": [
        "identity"
      ]
    },
    "contracts": [],
    "capabilities": {
      "contract_version": 2,
      "required": [
        "collection.read"
      ],
      "optional": [
        "records.create",
        "records.edit",
        "records.delete",
        "definitions.manage"
      ]
    },
    "files": {
      "required": [
        "list",
        "read"
      ],
      "optional": [
        "add"
      ],
      "scope": {
        "kind": "collection"
      }
    },
    "access": "full_collection"
  }
}
