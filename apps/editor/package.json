{
  "name": "mdbase-editor",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm manifest && vite --host 127.0.0.1",
    "build": "pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && vite build",
    "build:e2e": "pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && vite build --mode e2e",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm check:styles && node --test scripts/write-manifest.test.mjs scripts/check-style-tokens.test.mjs && node ../../scripts/ci/vitest.mjs",
    "test:deployment": "node --test scripts/verify-deployment-manifest.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/write-phosphor-icon-names.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@lezer/highlight": "^1.2.3",
    "@mdbase-dev/connect": "workspace:*",
    "@mdbase/connect-management": "workspace:*",
    "@mdbase-dev/connect-protocol": "workspace:*",
    "@mdbase-dev/ui": "workspace:*",
    "@mdbase/connect-ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/web": "^2.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdbase-dev/connect-dev": "workspace:*",
    "@mdbase-dev/connect-testing": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
