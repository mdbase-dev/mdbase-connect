{
  "name": "mdbase-editor",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm manifest && vite --host 127.0.0.1",
    "build": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm i18n:check && pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && vite build",
    "build:lab": "MDBASE_EDITOR_ORIGIN=https://editor-lab.mdbase.dev VITE_MDBASE_ENV=lab pnpm build",
    "build:staging": "MDBASE_ENV=staging VITE_MDBASE_ENV=staging MDBASE_EDITOR_ORIGIN=https://editor-staging.mdbase.dev MDBASE_EDITOR_BASE_PATH=/ MDBASE_CONNECT_URL=https://connect-staging.mdbase.dev pnpm build",
    "build:e2e": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm i18n:check && pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && VITE_MDBASE_EDITOR_DEMO=1 VITE_MDBASE_FEEDBACK_URL=http://127.0.0.1:8790/v1/feedback vite build --mode e2e",
    "check:bundle": "node --test scripts/bundle-assets.test.mjs && node scripts/check-bundle-size.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check --compose \"node_modules/@mdbase-dev/ui/dist/locales/{locale}/messages.json\" \"node_modules/@mdbase/connect-ui/dist/locales/{locale}/messages.json\"",
    "i18n:source": "mdbase-i18n source",
    "typecheck": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm i18n:source && tsc -b --pretty false",
    "test": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm i18n:source && pnpm check:styles && node --test scripts/write-manifest.test.mjs scripts/check-style-tokens.test.mjs && node ../../scripts/ci/vitest.mjs",
    "test:manifest": "node --test scripts/write-manifest.test.mjs",
    "test:entry": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && node ../../scripts/ci/vitest.mjs src/main.environment.test.ts",
    "test:deployment": "node --test scripts/verify-deployment-manifest.test.mjs",
    "test:publisher": "node --test scripts/sdk-pin.test.mjs scripts/native/publisher.test.mjs",
    "test:e2e": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && pnpm --filter @mdbase/connect-portal build && playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/write-phosphor-icon-names.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@lezer/highlight": "^1.2.3",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/connect": "workspace:*",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.129-c280cd194ffd.tgz",
    "@mdbase-dev/i18n": "workspace:*",
    "@mdbase-dev/sdk": "file:vendor/sdk-eaa4e697-production-beta141.tgz",
    "@mdbase-dev/ui": "workspace:*",
    "@mdbase/connect-ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/web": "^2.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.0.9",
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/vite-plugin": "6.10.1",
    "@mdbase-dev/connect-dev": "workspace:*",
    "@mdbase-dev/connect-testing": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
