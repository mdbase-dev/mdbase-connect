{
  "name": "mdbase-editor",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm manifest && vite --host 127.0.0.1",
    "build": "pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && vite build",
    "build:lab": "MDBASE_EDITOR_ORIGIN=https://editor-lab.mdbase.dev VITE_MDBASE_ENV=lab pnpm build",
    "build:staging": "MDBASE_ENV=staging VITE_MDBASE_ENV=staging MDBASE_EDITOR_ORIGIN=https://editor-staging.mdbase.dev MDBASE_EDITOR_BASE_PATH=/ MDBASE_CONNECT_URL=https://connect-staging.mdbase.dev pnpm build",
    "build:e2e": "pnpm check:styles && pnpm manifest && pnpm manifest:validate && tsc -b && VITE_MDBASE_EDITOR_DEMO=1 VITE_MDBASE_FEEDBACK_URL=http://127.0.0.1:8790/v1/feedback vite build --mode e2e",
    "check:bundle": "node --test scripts/bundle-assets.test.mjs && node scripts/check-bundle-size.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:styles": "node scripts/check-style-tokens.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm check:styles && node --test scripts/write-manifest.test.mjs scripts/check-style-tokens.test.mjs && node ../../scripts/ci/vitest.mjs",
    "test:manifest": "node --test scripts/write-manifest.test.mjs",
    "test:entry": "node ../../scripts/ci/vitest.mjs src/main.environment.test.ts",
    "test:deployment": "node --test scripts/verify-deployment-manifest.test.mjs",
    "test:publisher": "node --test scripts/native/publisher.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/write-phosphor-icon-names.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:validate": "node scripts/validate-manifest.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "2.15.1",
    "@lezer/highlight": "^1.2.3",
    "@mdbase-dev/connect": "workspace:*",
    "@mdbase-dev/sdk": "file:vendor/sdk-dev-eaa4e697-staging.tgz",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.129-c280cd194ffd.tgz",
    "@mdbase-dev/ui": "file:vendor/mdbase-dev-ui-dev-b2d7c464.tgz",
    "@phosphor-icons/react": "^2.1.10",
    "@phosphor-icons/web": "^2.1.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@mdbase-dev/connect-dev": "workspace:*",
    "@mdbase-dev/connect-testing": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  }
}
