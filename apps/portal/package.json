{
  "name": "@mdbase/connect-portal",
  "version": "0.1.0-beta.145",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:extract": "node ../../packages/i18n/scripts/cli.mjs extract",
    "i18n:compile": "node ../../packages/i18n/scripts/cli.mjs compile",
    "i18n:check": "node ../../packages/i18n/scripts/cli.mjs check",
    "build": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && vite build",
    "dev": "vite",
    "test": "node --import ../../packages/app-ui/scripts/register-macros.mjs --test *.test.mjs && node ../../scripts/ci/vitest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:i18n-integration": "pnpm --filter @mdbase-dev/i18n build && pnpm --filter @mdbase-dev/connect-protocol build && pnpm --filter @mdbase-dev/ui build && pnpm --filter @mdbase/connect-ui build && (result=0; pnpm build || result=1; pnpm typecheck || result=1; pnpm test || result=1; pnpm --filter @mdbase/connect-desktop build || result=1; pnpm --filter @mdbase/connect-desktop typecheck || result=1; pnpm --filter @mdbase/connect-desktop test || result=1; exit $result)",
    "pretest": "node ../../packages/app-ui/scripts/compile-catalogues.mjs"
  },
  "dependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/i18n": "workspace:*",
    "@mdbase/connect-management": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@mdbase/connect-ui": "workspace:*",
    "@mdbase-dev/connect-protocol": "workspace:*",
    "@mdbase-dev/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@lingui/vite-plugin": "6.9.0",
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.6"
  }
}
