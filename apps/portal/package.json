{
  "name": "@mdbase/connect-portal",
  "version": "0.1.0-beta.149",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check --compose \"../../packages/app-ui/src/locales/{locale}/messages.json\" \"../../packages/ui/locales/{locale}/messages.json\"",
    "build": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && vite build",
    "dev": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && vite",
    "test": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && node --import ../../packages/app-ui/scripts/register-macros.mjs --test *.test.mjs && node ../../scripts/ci/vitest.mjs",
    "typecheck": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && tsc -p tsconfig.json --noEmit",
    "verify:i18n-integration": "pnpm --filter @mdbase-dev/i18n build && pnpm --filter @mdbase-dev/connect-protocol build && pnpm --filter @mdbase-dev/ui build && pnpm --filter @mdbase/connect-ui build && (result=0; pnpm build || result=1; pnpm typecheck || result=1; pnpm test || result=1; pnpm --filter @mdbase/connect-desktop build || result=1; pnpm --filter @mdbase/connect-desktop typecheck || result=1; pnpm --filter @mdbase/connect-desktop test || result=1; exit $result)"
  },
  "dependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/connect-protocol": "workspace:*",
    "@mdbase-dev/i18n": "workspace:*",
    "@mdbase-dev/ui": "workspace:*",
    "@mdbase/connect-management": "workspace:*",
    "@mdbase/connect-ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/vite-plugin": "6.10.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
