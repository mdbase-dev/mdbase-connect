{
  "compilerOptions": {
    "target": "ES2022",
    "resolveJsonModule": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "rootDir": "src",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/main/**/*.ts"]
}
