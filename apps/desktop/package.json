{
  "name": "@mdbase/connect-desktop",
  "productName": "mdbase connect",
  "version": "0.1.0-beta.145",
  "description": "Connect applications to authorized mdbase collections.",
  "author": "mdbase",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check --compose '../../packages/app-ui/src/locales/{locale}/messages.json' '../../packages/ui/locales/{locale}/messages.json'",
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && tsc -p tsconfig.main.json && node scripts/build-main.mjs",
    "build:renderer": "node ../../packages/app-ui/scripts/compile-catalogues.mjs && vite build",
    "build:standalone": "pnpm --filter @mdbase-dev/connect-protocol --filter @mdbase-dev/ui build && pnpm build",
    "stage:daemon": "node scripts/stage-daemon.mjs",
    "start": "pnpm build:standalone && electron .",
    "make": "pnpm stage:daemon && pnpm build:standalone && electron-forge make",
    "package": "pnpm stage:daemon && pnpm build:standalone && electron-forge package && node scripts/verify-package.mjs",
    "test": "pnpm build:main && pnpm ensure:electron && node --import ../../packages/app-ui/scripts/register-macros.mjs --test test/*.test.mjs",
    "test:renderer": "pnpm build:renderer && node --test scripts/renderer-ux.test.mjs",
    "ensure:electron": "node -e \"require('electron')\"",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/i18n": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "scheduler": "^0.28.0"
  },
  "devDependencies": {
    "@lingui/vite-plugin": "6.9.0",
    "@babel/core": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.9.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-appx": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@mdbase/connect-ui": "workspace:*",
    "@mdbase-dev/connect-protocol": "workspace:*",
    "@mdbase-dev/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.5.0",
    "esbuild": "^0.28.1",
    "lodash": "^4.18.1",
    "playwright-core": "^1.61.1",
    "sigstore": "4.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.6"
  }
}
