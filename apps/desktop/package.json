{
  "name": "@mdbase/connect-desktop",
  "productName": "mdbase connect",
  "version": "0.1.0-beta.90",
  "description": "Connect applications to authorized mdbase collections.",
  "author": "mdbase",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build:standalone": "pnpm build",
    "dev:daemon": "cargo build --manifest-path ../../Cargo.toml -p mdbase-cli",
    "start": "pnpm dev:daemon && pnpm build:standalone && electron .",
    "make": "pnpm dev:daemon --release && pnpm build:standalone && electron-forge make",
    "package": "pnpm dev:daemon --release && pnpm build:standalone && electron-forge package && node scripts/verify-package.mjs",
    "test": "pnpm build:main && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-appx": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@mdbase/connect-ui": "workspace:*",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "esbuild": "^0.28.2",
    "lodash": "^4.18.1",
    "playwright-core": "^1.62.1",
    "sigstore": "5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
