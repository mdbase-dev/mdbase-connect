# SQL migrations are immutable release inputs. Keep their bytes identical on
# every checkout so embedded checksums and migration safety hashes are stable.
*.sql text eol=lf
# Digest-pinned type packs are verified byte for byte, including line endings.
*.pack.json text eol=lf
# Derived inventories: resolve source conflicts, then regenerate (CONTRIBUTING.md).
packages/client/public-api.json linguist-generated=true text eol=lf
packages/protocol/src/*.generated.ts linguist-generated=true text eol=lf
crates/connect-protocol/src/*_generated.rs linguist-generated=true text eol=lf
