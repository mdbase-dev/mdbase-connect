{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/connect/schemas/sync.v1.json",
  "title": "mdbase connect replication protocol 1",
  "oneOf": [
    { "$ref": "#/$defs/session" },
    { "$ref": "#/$defs/snapshotPage" },
    { "$ref": "#/$defs/changesPage" },
    { "$ref": "#/$defs/mutation" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "collectionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "extensions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "schema": { "type": "object" },
        "collection": { "type": "object" },
        "lifecycle": { "type": "object" },
        "extensions": { "type": "object" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_type", "id", "version", "digest", "schema", "implementations"],
      "properties": {
        "contract_type": { "const": "record" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "digest": { "$ref": "#/$defs/digest" },
        "schema": { "type": "object" },
        "binding_schema": { "type": "object" },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contractImplementation" }
        }
      }
    },
    "contractImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_name", "type_version", "digest", "fields"],
      "properties": {
        "type_name": { "type": "string", "minLength": 1 },
        "type_version": { "type": "integer", "minimum": 1 },
        "type_path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "binding": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "spec_version", "types", "contracts"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "spec_version": { "type": "string", "minLength": 1 },
        "types": { "type": "array", "items": { "$ref": "#/$defs/collectionType" } },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/resourceDocument" } }
      }
    },
    "resourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "revision", "document"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["configuration", "type", "contract", "schema", "view"] },
        "revision": { "type": "string", "minLength": 1 },
        "document": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "path", "revision", "frontmatter", "body", "types"],
      "properties": {
        "record_id": { "$ref": "#/$defs/uuid" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "frontmatter": { "type": "object" },
        "body": { "type": "string" },
        "types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "snapshotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "path", "revision", "frontmatter", "body", "types", "document"],
      "properties": {
        "record_id": { "$ref": "#/$defs/uuid" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "frontmatter": { "type": "object" },
        "body": { "type": "string" },
        "types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "document": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "session_id", "replica_id", "collection_id", "mode", "scope_epoch", "retained_after", "head", "snapshot_id", "resources"],
      "properties": {
        "protocol_version": { "const": 1 },
        "session_id": { "$ref": "#/$defs/uuid" },
        "replica_id": { "$ref": "#/$defs/uuid" },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "mode": { "enum": ["read_only", "read_write"] },
        "scope_epoch": { "type": "integer", "minimum": 1 },
        "retained_after": { "type": "integer", "minimum": 0 },
        "head": { "type": "integer", "minimum": 0 },
        "snapshot_id": { "$ref": "#/$defs/uuid" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "snapshotPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "snapshot_id", "scope_epoch", "cursor", "records"],
      "properties": {
        "protocol_version": { "const": 1 },
        "snapshot_id": { "$ref": "#/$defs/uuid" },
        "scope_epoch": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "integer", "minimum": 0 },
        "records": { "type": "array", "items": { "$ref": "#/$defs/snapshotRecord" } },
        "next_page": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "put": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "record"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "const": "put" },
        "record": { "$ref": "#/$defs/record" }
      }
    },
    "remove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "record_id", "previous_path", "revision"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "const": "remove" },
        "record_id": { "$ref": "#/$defs/uuid" },
        "previous_path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "changesPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "scope_epoch", "events", "cursor", "head", "has_more", "reset_required"],
      "properties": {
        "protocol_version": { "const": 1 },
        "scope_epoch": { "type": "integer", "minimum": 1 },
        "events": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/put" }, { "$ref": "#/$defs/remove" }] } },
        "cursor": { "type": "integer", "minimum": 0 },
        "head": { "type": "integer", "minimum": 0 },
        "has_more": { "type": "boolean" },
        "reset_required": { "type": "boolean" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "replica_id", "scope_epoch", "operation", "record_id", "input", "created_at"],
      "properties": {
        "mutation_id": { "$ref": "#/$defs/uuid" },
        "replica_id": { "$ref": "#/$defs/uuid" },
        "scope_epoch": { "type": "integer", "minimum": 1 },
        "operation": { "enum": ["create", "update", "rename", "delete"] },
        "record_id": { "$ref": "#/$defs/uuid" },
        "base_revision": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "causal_predecessor": { "$ref": "#/$defs/uuid" }
      }
    },
    "receipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_id", "status", "sequence"],
          "properties": {
            "mutation_id": { "$ref": "#/$defs/uuid" },
            "status": { "enum": ["applied", "previously_applied"] },
            "sequence": { "type": "integer", "minimum": 1 },
            "record": { "$ref": "#/$defs/record" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_id", "status", "conflict"],
          "properties": {
            "mutation_id": { "$ref": "#/$defs/uuid" },
            "status": { "const": "conflicted" },
            "conflict": {
              "type": "object",
              "additionalProperties": false,
              "required": ["record_id", "mutation"],
              "properties": {
                "record_id": { "$ref": "#/$defs/uuid" },
                "mutation": { "$ref": "#/$defs/mutation" },
                "current": { "$ref": "#/$defs/record" },
                "current_revision": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutation_id", "status", "error"],
          "properties": {
            "mutation_id": { "$ref": "#/$defs/uuid" },
            "status": { "const": "rejected" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string" }
              }
            }
          }
        }
      ]
    }
  }
}
