{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/connect/schemas/connect-protocol.v1.json",
  "title": "mdbase connect protocol 1",
  "description": "Canonical wire shapes shared by applications, the control plane, and connectors.",
  "oneOf": [
    { "$ref": "#/$defs/relayOperationRequest" },
    { "$ref": "#/$defs/relayOperationResponse" },
    { "$ref": "#/$defs/relayPolicySnapshot" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "operation": {
      "enum": ["describe", "changes", "read", "query", "list_views", "execute_view", "read_view_source", "create_view_source", "update_view_source", "delete_view_source", "validate", "create", "update", "delete", "rename", "read_type", "create_type", "update_type", "list_timers", "put_timer", "cancel_timer", "reconcile_timers"]
    },
    "contractRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "grantScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "access": { "enum": ["contract", "full_collection"] },
        "contracts": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/contractRequirement" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "field": { "type": "string" },
        "type": { "type": "string" },
        "schema_location": { "type": "string" },
        "details": true
      }
    },
    "operationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "result", "diagnostics"],
      "properties": {
        "valid": { "type": "boolean" },
        "result": true,
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
      }
    },
    "relayOperationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "grant_id", "collection_id", "application_id", "operation", "input"],
      "properties": {
        "type": { "const": "operation_request" },
        "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/uuid" },
        "grant_id": { "$ref": "#/$defs/uuid" },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "application_id": { "$ref": "#/$defs/uuid" },
        "operation": { "$ref": "#/$defs/operation" },
        "input": true
      }
    },
    "relayOperationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "request_id", "ok"],
      "properties": {
        "type": { "const": "operation_response" },
        "protocol_version": { "const": 1 },
        "request_id": { "$ref": "#/$defs/uuid" },
        "ok": { "type": "boolean" },
        "result": true,
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": {
            "properties": { "result": true },
            "required": ["result"],
            "not": { "properties": { "error": true }, "required": ["error"] }
          },
          "else": {
            "properties": { "error": true },
            "required": ["error"],
            "not": { "properties": { "result": true }, "required": ["result"] }
          }
        }
      ]
    },
    "grantPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "application_id", "collection_id", "operations", "scope", "application_name", "application_homepage", "collection_name", "created_at"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "application_id": { "$ref": "#/$defs/uuid" },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "scope": { "$ref": "#/$defs/grantScope" },
        "application_name": { "type": "string", "minLength": 1 },
        "application_distribution": { "enum": ["web", "portable"] },
        "application_homepage": { "type": "string" },
        "application_project_url": { "type": "string", "format": "uri" },
        "application_origin": {
          "anyOf": [
            { "const": "null" },
            { "type": "string", "format": "uri" }
          ]
        },
        "application_icon": { "type": "string" },
        "collection_name": { "type": "string", "minLength": 1 },
        "notification_criteria": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/notificationCriterion" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "encryption": { "$ref": "#/$defs/grantEncryption" }
      }
    },
    "notificationCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event", "presentation"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "event": { "$ref": "#/$defs/contractRequirement" },
        "if": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$expr"],
          "properties": { "$expr": { "type": "string", "minLength": 1, "maxLength": 4096 } }
        },
        "debounce": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d)$" },
        "minimum_interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h|d)$" },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 80 },
            "body": { "type": "string", "maxLength": 160 },
            "tag": { "type": "string", "minLength": 1, "maxLength": 80 }
          }
        }
      }
    },
    "grantEncryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "suite", "key_id", "scope_epoch", "connector_id", "collection_id", "application_public_key", "connector_public_key"],
      "properties": {
        "protocol_version": { "const": 1 },
        "suite": { "const": "P256-HKDF-SHA256-AES256GCM" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scope_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "connector_id": { "$ref": "#/$defs/uuid" },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "application_public_key": { "type": "string", "minLength": 80, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" },
        "connector_public_key": { "type": "string", "minLength": 80, "maxLength": 200, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "relayPolicySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol_version", "grants"],
      "properties": {
        "type": { "const": "policy_snapshot" },
        "protocol_version": { "const": 1 },
        "grants": { "type": "array", "items": { "$ref": "#/$defs/grantPolicy" } }
      }
    },
    "collectionDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "collection_id", "display_name", "spec_version", "operations", "change_cursor", "types", "contracts"],
      "properties": {
        "protocol_version": { "const": 1 },
        "collection_id": { "$ref": "#/$defs/uuid" },
        "display_name": { "type": "string", "minLength": 1 },
        "spec_version": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/operation" } },
        "change_cursor": { "type": "integer", "minimum": 0 },
        "types": { "type": "array", "items": { "$ref": "#/$defs/collectionType" } },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/collectionContract" } },
        "configuration": { "type": "object", "description": "Canonical portable collection settings. Extension and implementation-specific values are omitted." }
      }
    },
    "collectionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "extensions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "path": { "type": "string", "minLength": 1, "description": "Collection-relative source path." },
        "definition": { "type": "object", "description": "Complete portable type frontmatter, including extension declarations." },
        "schema": { "type": "object" },
        "collection": { "type": "object" },
        "lifecycle": { "type": "object" },
        "extensions": { "type": "object" }
      }
    },
    "collectionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "type_name", "extension", "configuration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "type_name": { "type": "string", "minLength": 1 },
        "extension": { "type": "string", "pattern": "^x-[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "configuration": { "type": "object" }
      }
    },
    "changesPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "cursor", "has_more", "reset"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "cursor": { "type": "integer", "minimum": 0 },
        "has_more": { "type": "boolean" },
        "reset": { "type": "boolean" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "type", "occurred_at", "payload"],
      "properties": {
        "cursor": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      }
    }
  }
}
