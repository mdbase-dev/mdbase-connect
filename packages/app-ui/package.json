{
  "name": "@mdbase-dev/ui",
  "version": "0.1.0-beta.115",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdbase-dev/mdbase-connect.git",
    "directory": "packages/app-ui"
  },
  "homepage": "https://mdbase.dev",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./apps": {
      "types": "./dist/apps.d.ts",
      "import": "./dist/apps.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./brand.css": "./css/brand.css",
    "./fonts.css": "./css/fonts.css",
    "./motion.css": "./css/motion.css",
    "./tokens.css": "./css/tokens.css"
  },
  "files": [
    "css",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
