{
  "name": "@mdbase/connect-ui",
  "version": "0.1.0-beta.145",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:extract": "mdbase-i18n extract",
    "i18n:compile": "mdbase-i18n compile",
    "i18n:check": "mdbase-i18n check",
    "build": "node ../app-ui/scripts/compile-catalogues.mjs && tsc -p tsconfig.json && node ../app-ui/scripts/compile-macros.mjs",
    "test": "node --import ../app-ui/scripts/register-macros.mjs --test access.test.ts contract-setup.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./i18n": "./dist/i18n.js",
    "./access": "./dist/access.js",
    "./contract-setup": "./dist/contract-setup.js",
    "./provider-button": "./dist/provider-button.js",
    "./styles.css": "./styles.css"
  },
  "devDependencies": {
    "@mdbase-dev/i18n": "workspace:*",
    "typescript": "^7.0.2",
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0"
  },
  "dependencies": {
    "@mdbase-dev/ui": "workspace:*",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@lingui/core": "6.9.0",
    "@lingui/react": "6.9.0",
    "@mdbase-dev/i18n": "*"
  }
}
