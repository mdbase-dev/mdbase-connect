{
  "name": "@mdbase-dev/connect",
  "version": "0.1.0-beta.52",
  "private": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdbase-dev/mdbase-connect.git",
    "directory": "packages/client"
  },
  "homepage": "https://mdbase.dev/sdk/",
  "sideEffects": false,
  "browser": "./dist/browser/mdbase-connect.min.js",
  "unpkg": "./dist/browser/mdbase-connect.min.js",
  "jsdelivr": "./dist/browser/mdbase-connect.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./crypto": {
      "types": "./dist/crypto-entry.d.ts",
      "import": "./dist/crypto-entry.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@mdbase-dev/connect-protocol": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/build-browser.mjs",
    "test": "vitest run",
    "test:browser-storage": "pnpm build && node scripts/browser-storage.test.mjs",
    "test:consumer-spikes": "tsc -p tsconfig.consumer-spikes.json",
    "test:public-api": "pnpm build && pnpm --filter @mdbase-dev/connect-protocol build && pnpm --filter @mdbase-dev/connect-testing build && tsc -p tsconfig.public-api.json && node scripts/check-public-api.mjs && node scripts/test-packed-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
