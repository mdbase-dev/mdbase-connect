#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH='' cd -- "$(dirname "$0")/../.." && pwd)
# shellcheck source=test/upgrade/lib.sh
source "$repo_root/test/upgrade/lib.sh"
# The release pin is resolved from the repository root above.
# shellcheck disable=SC1091
source "$repo_root/.github/previous-release.env"

CANDIDATE_IMAGE=${CANDIDATE_IMAGE:-mdbase-connect-hosted-provider:upgrade-candidate}
PROVIDER_INTERNAL_TOKEN=${PROVIDER_INTERNAL_TOKEN:-previous-provider-upgrade-internal-token}
PROVIDER_MASTER_KEY=${PROVIDER_MASTER_KEY:-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA}
MDBASE_CONNECT_R2_ENDPOINT=${MDBASE_CONNECT_R2_ENDPOINT:-http://127.0.0.1:9000}
MDBASE_CONNECT_R2_BUCKET=${MDBASE_CONNECT_R2_BUCKET:-upgrade-canary}
MDBASE_CONNECT_R2_ACCESS_KEY_ID=${MDBASE_CONNECT_R2_ACCESS_KEY_ID:-upgrade-canary}
MDBASE_CONNECT_R2_SECRET_ACCESS_KEY=${MDBASE_CONNECT_R2_SECRET_ACCESS_KEY:-upgrade-canary-secret}
MDBASE_CONNECT_ALLOW_INSECURE_R2=${MDBASE_CONNECT_ALLOW_INSECURE_R2:-true}
UPGRADE_ACCOUNT_ID=11111111-1111-4111-8111-111111111111
UPGRADE_COLLECTION_ID=33333333-3333-4333-8333-333333333333
UPGRADE_REPLICA_ID=44444444-4444-4444-8444-444444444444
UPGRADE_MUTATION_ID=66666666-6666-4666-8666-666666666666
UPGRADE_NEXT_MUTATION_ID=88888888-8888-4888-8888-888888888888
UPGRADE_RECORD_ID=77777777-7777-4777-8777-777777777777
UPGRADE_REPLICA_TOKEN=previous-provider-upgrade-replica-token
CUTOVER_OWNER_TOKEN=99999999-9999-4999-8999-999999999991
UPGRADE_DATABASE_PORT=${UPGRADE_DATABASE_PORT:-5432}
UPGRADE_PROVIDER_PORT=${UPGRADE_PROVIDER_PORT:-8790}
UPGRADE_PROVIDER_URL="http://127.0.0.1:$UPGRADE_PROVIDER_PORT"
export PROVIDER_INTERNAL_TOKEN PROVIDER_MASTER_KEY
export MDBASE_CONNECT_R2_ENDPOINT MDBASE_CONNECT_R2_BUCKET
export MDBASE_CONNECT_R2_ACCESS_KEY_ID MDBASE_CONNECT_R2_SECRET_ACCESS_KEY
export MDBASE_CONNECT_ALLOW_INSECURE_R2
upgrade_require DATABASE_URL MDBASE_CONNECT_PREVIOUS_PROVIDER_IMAGE

r2_pid=
terminate_cutover_lock_holder() {
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" \
      --username mdbase --dbname mdbase_provider_upgrade \
      --set ON_ERROR_STOP=1 \
      --command "SELECT pg_terminate_backend(pid)
                 FROM pg_stat_activity
                 WHERE application_name = 'mdbase-provider-cutover-lock-holder'
                   AND pid <> pg_backend_pid()" \
    >/dev/null 2>&1 || true
}

cleanup() {
  terminate_cutover_lock_holder
  for container in \
    mdbase-provider-previous \
    mdbase-provider-previous-migration \
    mdbase-provider-cutover-lock \
    mdbase-provider-upgrade-candidate
  do
    docker logs "$container" >/dev/null 2>&1 || true
    upgrade_remove_container "$container"
  done
  if [[ -n $r2_pid ]]; then
    kill "$r2_pid" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

start_previous_provider() {
  local name=$1
  local remove_after_ready=${2:-true}
  docker run --detach --name "$name" \
    --network host \
    --env DATABASE_URL \
    --env MDBASE_CONNECT_HOSTED_PROVIDER_INTERNAL_TOKEN="$PROVIDER_INTERNAL_TOKEN" \
    --env MDBASE_CONNECT_HOSTED_PROVIDER_MASTER_KEY="$PROVIDER_MASTER_KEY" \
    --env MDBASE_CONNECT_R2_ENDPOINT \
    --env MDBASE_CONNECT_R2_BUCKET \
    --env MDBASE_CONNECT_R2_ACCESS_KEY_ID \
    --env MDBASE_CONNECT_R2_SECRET_ACCESS_KEY \
    --env MDBASE_CONNECT_ALLOW_INSECURE_R2 \
    --env PORT="$UPGRADE_PROVIDER_PORT" \
    "$MDBASE_CONNECT_PREVIOUS_PROVIDER_IMAGE" >/dev/null
  if ! upgrade_wait_http "$UPGRADE_PROVIDER_URL/ready" 'previous provider'; then
    docker logs "$name"
    return 1
  fi
  if [[ $remove_after_ready == true ]]; then
    upgrade_remove_container "$name"
  fi
}

provider_json() {
  local method=$1
  local path=$2
  local body=$3
  local token=${4:-$PROVIDER_INTERNAL_TOKEN}
  curl --fail-with-body --silent --show-error \
    --request "$method" \
    --header 'content-type: application/json' \
    --header "authorization: Bearer $token" \
    --data "$body" \
    "$UPGRADE_PROVIDER_URL$path"
}

seed_previous_sync_receipt() {
  provider_json PUT "/internal/v1/accounts/$UPGRADE_ACCOUNT_ID" \
    '{"entitlement_revision":1,"hosted_storage_bytes":1073741824,"retained_file_bytes":2147483648,"max_document_bytes":2097152,"max_single_file_bytes":262144000,"max_mirror_replicas_per_collection":10,"max_application_replicas_per_collection":10,"max_hosted_collections":10,"max_files_per_collection":10000}' >/dev/null
  provider_json POST /internal/v1/collections \
    "{\"account_id\":\"$UPGRADE_ACCOUNT_ID\",\"collection_id\":\"$UPGRADE_COLLECTION_ID\",\"template\":\"mdbase\",\"display_name\":\"Upgrade receipt probe\",\"timezone\":\"Australia/Melbourne\"}" >/dev/null
  provider_json POST "/internal/v1/collections/$UPGRADE_COLLECTION_ID/replicas" \
    "{\"replica_id\":\"$UPGRADE_REPLICA_ID\",\"name\":\"Upgrade receipt writer\",\"purpose\":\"mirror\",\"mode\":\"read_write\",\"allowed_types\":[],\"contract_scope\":[],\"full_collection\":false,\"allowed_operations\":[],\"grant_id\":null,\"token\":\"$UPGRADE_REPLICA_TOKEN\"}" >/dev/null
  provider_json POST "/v1/authorities/$UPGRADE_COLLECTION_ID/sync/mutations" \
    "$(previous_mutation_body)" "$UPGRADE_REPLICA_TOKEN"
}

previous_mutation_body() {
  jq --compact-output --null-input \
    --arg mutation_id "$UPGRADE_MUTATION_ID" \
    --arg replica_id "$UPGRADE_REPLICA_ID" \
    --arg record_id "$UPGRADE_RECORD_ID" \
    --arg document $'---\ntitle: Preserved beta receipt\n---\n\nExact beta69 bytes.\n' \
    '{mutation_id:$mutation_id,replica_id:$replica_id,scope_epoch:1,operation:"put",record_id:$record_id,path:"upgrade/receipt.md",document:$document,created_at:"2026-08-04T00:00:00Z"}'
}

exact_mutation_body() {
  local base_revision=$1
  jq --compact-output --null-input \
    --arg mutation_id "$UPGRADE_NEXT_MUTATION_ID" \
    --arg replica_id "$UPGRADE_REPLICA_ID" \
    --arg record_id "$UPGRADE_RECORD_ID" \
    --arg base_revision "$base_revision" \
    --arg document $'---\ntitle: Exact beta receipt\n---\n\nExact bytes.\n' \
    '{mutation_id:$mutation_id,replica_id:$replica_id,scope_epoch:1,operation:"put",record_id:$record_id,base_revision:$base_revision,path:"upgrade/receipt.md",document:$document,created_at:"2026-08-06T00:00:00Z"}'
}

query_canonical_authority_inventory() {
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" --username mdbase --dbname mdbase_provider_upgrade \
    --set ON_ERROR_STOP=1 --tuples-only --no-align \
    --command "SELECT jsonb_build_object(
                 'collection', (
                   SELECT to_jsonb(canonical)
                   FROM (
                     SELECT id, template, spec_version, authority_epoch, head,
                            retained_after, record_count, content_bytes, max_records,
                            max_content_bytes, max_document_bytes, max_mirror_replicas,
                            resource_revision, wrapped_data_key, resources_ciphertext,
                            state, created_at, display_name, file_count, file_bytes,
                            stored_file_bytes, max_files, max_file_bytes,
                            max_stored_file_bytes, max_single_file_bytes, account_id,
                            timezone, max_application_replicas
                     FROM hosted_provider_collections
                     WHERE id = '$UPGRADE_COLLECTION_ID'
                   ) canonical
                 ),
                 'records', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY record_id)
                   FROM hosted_provider_records row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'record_versions', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY record_id, sequence)
                   FROM hosted_provider_record_versions row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'changes', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY sequence)
                   FROM hosted_provider_changes row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'resources', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY path)
                   FROM hosted_provider_resources row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'resource_changes', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY sequence, path)
                   FROM hosted_provider_resource_changes row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'files', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY file_id)
                   FROM hosted_provider_files row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'file_versions', COALESCE((
                   SELECT jsonb_agg(to_jsonb(row_data) ORDER BY file_id, revision)
                   FROM hosted_provider_file_versions row_data
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb),
                 'journal', COALESCE((
                   SELECT jsonb_agg(
                     jsonb_build_object(
                       'replica_id', replica_id,
                       'grant_id', grant_id,
                       'request_id', request_id,
                       'operation_kind', operation_kind,
                       'fingerprint_schema_version', fingerprint_schema_version,
                       'input_schema_version', input_schema_version,
                       'input_digest', input_digest,
                       'state', state,
                       'fencing_generation', fencing_generation,
                       'prepared_head', prepared_head,
                       'prepared_ciphertext', prepared_ciphertext,
                       'evidence_ciphertext', evidence_ciphertext,
                       'evidence_kind', evidence_kind,
                       'effect_applied', effect_applied,
                       'final_receipt_ciphertext', final_receipt_ciphertext,
                       'receipt_digest', receipt_digest,
                       'accepted_at', accepted_at,
                       'completed_at', completed_at
                     ) ORDER BY request_id
                   )
                   FROM hosted_provider_mutation_journal
                   WHERE replica_id = '$UPGRADE_REPLICA_ID'
                 ), '[]'::jsonb),
                 'outbox_authority', COALESCE((
                   SELECT jsonb_agg(
                     jsonb_build_object(
                       'collection_id', collection_id,
                       'sequence', sequence,
                       'event_type', event_type,
                       'payload', payload,
                       'occurred_at', occurred_at
                     ) ORDER BY sequence, event_type
                   )
                   FROM hosted_provider_runtime_outbox
                   WHERE collection_id = '$UPGRADE_COLLECTION_ID'
                 ), '[]'::jsonb)
               )::text" \
    | sha256sum \
    | cut -d ' ' -f 1
}

run_projection_indexer() {
  local command=$1
  shift
  docker run --rm --network host \
    --env DATABASE_URL="$DATABASE_URL" \
    --env MDBASE_CONNECT_HOSTED_PROVIDER_MASTER_KEY="$PROVIDER_MASTER_KEY" \
    --entrypoint mdbase-hosted-projection-indexer \
    "$CANDIDATE_IMAGE" "$command" "$@"
}

query_notification_contract() {
  local include_digest=${1:-false}
  local digest_expression=
  if [[ $include_digest == true ]]; then
    digest_expression=", '|', grant_json #>> '{notification_criteria,0,event,digest}'"
  fi
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" --username mdbase --dbname mdbase_provider_upgrade \
    --set ON_ERROR_STOP=1 \
    --tuples-only --no-align \
    --command "SELECT concat(
                 grant_json #>> '{notification_criteria,0,event,id}',
                 '|',
                 grant_json #>> '{notification_criteria,0,event,version}'
                 $digest_expression
               )
               FROM hosted_provider_notification_grants
               WHERE grant_id = '22222222-2222-4222-8222-222222222222'"
}

query_connect_contracts() {
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" --username mdbase --dbname mdbase_provider_upgrade \
    --set ON_ERROR_STOP=1 \
    --tuples-only --no-align \
    --command "SELECT concat(
                 grant_json #>> '{contracts,operation_transport}', '|',
                 grant_json #>> '{contracts,authorization_binding}', '|',
                 grant_json #>> '{contracts,semantic_capabilities}', '|',
                 grant_json #>> '{contracts,durable_mutation}'
               )
               FROM hosted_provider_notification_grants
               WHERE grant_id = '22222222-2222-4222-8222-222222222222'"
}

query_notification_application_binding() {
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" --username mdbase --dbname mdbase_provider_upgrade \
    --set ON_ERROR_STOP=1 \
    --tuples-only --no-align \
    --command "SELECT concat(
                 grant_json ->> 'application_declaration_id', '|',
                 grant_json ->> 'application_manifest_digest'
               )
               FROM hosted_provider_notification_grants
               WHERE grant_id = '22222222-2222-4222-8222-222222222222'"
}

upgrade_phase 'building candidate provider'
docker build \
  --file "$repo_root/deploy/docker/Dockerfile.hosted-provider" \
  --tag "$CANDIDATE_IMAGE" \
  "$repo_root"

upgrade_phase 'starting the test-only S3 readiness stub'
node "$repo_root/test/upgrade/r2-readiness-stub.mjs" \
  >"${RUNNER_TEMP:-/tmp}/mdbase-upgrade-r2.log" 2>&1 &
r2_pid=$!
if ! upgrade_wait_http http://127.0.0.1:9000 'S3 readiness stub' 30 1; then
  cat "${RUNNER_TEMP:-/tmp}/mdbase-upgrade-r2.log"
  exit 1
fi

upgrade_phase 'creating the previous provider schema'
docker pull "$MDBASE_CONNECT_PREVIOUS_PROVIDER_IMAGE"
start_previous_provider mdbase-provider-previous false

upgrade_phase 'seeding an encrypted previous-release sync receipt'
previous_receipt=$(seed_previous_sync_receipt)
printf 'Previous release sync receipt: %s\n' "$previous_receipt"
jq -e '.status == "applied" and .record.path == "upgrade/receipt.md"' \
  <<<"$previous_receipt" >/dev/null
previous_revision=$(jq -r '.record.revision' <<<"$previous_receipt")
upgrade_remove_container mdbase-provider-previous

upgrade_phase 'seeding the persisted previous-release notification shape'
docker run --rm --interactive --network host \
  --env PGPASSWORD=previous-provider-upgrade \
  postgres:18-alpine \
  psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" --username mdbase --dbname mdbase_provider_upgrade \
  --set ON_ERROR_STOP=1 \
  <"$repo_root/test/upgrade/provider-notification.sql"

upgrade_phase 'reopening persisted state with the previous release'
start_previous_provider mdbase-provider-previous-migration
previous_contract=$(query_notification_contract)
printf 'Previous release notification contract: %s\n' "$previous_contract"
[[ $previous_contract == "mdbase.runtime.timer.fired|1.0.0" ]]
canonical_inventory_before=$(query_canonical_authority_inventory)
printf 'Previous release canonical authority inventory: sha256:%s\n' \
  "$canonical_inventory_before"

upgrade_phase 'indexing the complete preserved authority with the bounded cutover operator'
docker run --detach --name mdbase-provider-cutover-lock --network host \
  --env PGPASSWORD=previous-provider-upgrade \
  --env PGAPPNAME=mdbase-provider-cutover-lock-holder \
  postgres:18-alpine \
  psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" \
    --username mdbase --dbname mdbase_provider_upgrade \
    --set ON_ERROR_STOP=1 \
    --command "SELECT pg_advisory_lock(hashtextextended('mdbase-candidate-b-cutover-v1', 0)); SELECT pg_sleep(30)" \
  >/dev/null
for _ in {1..30}; do
  lock_count=$(docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    postgres:18-alpine \
    psql --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT" \
      --username mdbase --dbname mdbase_provider_upgrade \
      --tuples-only --no-align \
      --command "SELECT count(*)
                 FROM pg_locks
                 JOIN pg_stat_activity USING (pid)
                 WHERE locktype = 'advisory'
                   AND granted
                   AND application_name = 'mdbase-provider-cutover-lock-holder'" |
    tr -d '[:space:]')
  [[ $lock_count != 0 ]] && break
  sleep 1
done
[[ ${lock_count:-0} != 0 ]]
if lock_result=$(run_projection_indexer cutover \
  --owner-token 99999999-9999-4999-8999-999999999990 \
  --max-seconds 30)
then
  printf 'Projection cutover unexpectedly ignored the global PostgreSQL lock.\n' >&2
  exit 1
fi
jq -e '
  .ok == false and
  .command == "cutover" and
  .result.outcome == "projection_cutover_lock_unavailable" and
  .result.phase == "global_lock"
' <<<"$lock_result" >/dev/null
terminate_cutover_lock_holder
upgrade_remove_container mdbase-provider-cutover-lock

if bounded_result=$(run_projection_indexer cutover \
  --owner-token "$CUTOVER_OWNER_TOKEN" \
  --page-limit 1 \
  --batches-per-collection 1 \
  --max-collections 10 \
  --max-batches 1 \
  --max-pages 10 \
  --max-seconds 120)
then
  printf 'Projection cutover unexpectedly completed inside the one-batch test budget.\n' >&2
  exit 1
fi
jq -e '
  .ok == false and
  .command == "cutover" and
  .result.outcome == "projection_cutover_batch_budget_exceeded" and
  .result.complete_inventory == false and
  .result.collections_verified == 0 and
  .result.batches_advanced == 1 and
  .result.blocked_collection_id == "33333333-3333-4333-8333-333333333333"
' <<<"$bounded_result" >/dev/null
verify_result=$(run_projection_indexer cutover \
  --owner-token "$CUTOVER_OWNER_TOKEN" \
  --page-limit 1 \
  --batches-per-collection 16 \
  --max-collections 10 \
  --max-batches 160 \
  --max-pages 10 \
  --max-seconds 120)
jq -e '
  .ok == true and
  .command == "cutover" and
  .result.outcome == "complete" and
  .result.complete_inventory == true and
  .result.pages_visited == 1 and
  .result.collections_verified == 1 and
  .result.batches_advanced > 0 and
  .result.blocked_collection_id == null
' <<<"$verify_result" >/dev/null
canonical_inventory_after_index=$(query_canonical_authority_inventory)
printf 'Indexed candidate canonical authority inventory: sha256:%s\n' \
  "$canonical_inventory_after_index"
[[ $canonical_inventory_after_index == "$canonical_inventory_before" ]]

upgrade_phase 'requiring candidate recovery readiness'
docker run --detach --name mdbase-provider-upgrade-candidate \
  --network host \
  --env DATABASE_URL \
  --env MDBASE_CONNECT_HOSTED_PROVIDER_INTERNAL_TOKEN="$PROVIDER_INTERNAL_TOKEN" \
  --env MDBASE_CONNECT_HOSTED_PROVIDER_MASTER_KEY="$PROVIDER_MASTER_KEY" \
  --env MDBASE_CONNECT_CONTROL_PLANE_URL=http://127.0.0.1:9 \
  --env MDBASE_CONNECT_R2_ENDPOINT \
  --env MDBASE_CONNECT_R2_BUCKET \
  --env MDBASE_CONNECT_R2_ACCESS_KEY_ID \
  --env MDBASE_CONNECT_R2_SECRET_ACCESS_KEY \
  --env MDBASE_CONNECT_ALLOW_INSECURE_R2 \
  --env PORT="$UPGRADE_PROVIDER_PORT" \
  "$CANDIDATE_IMAGE" >/dev/null

recovered=false
for attempt in {1..30}; do
  readiness=$(curl --silent "$UPGRADE_PROVIDER_URL/ready" || true)
  if jq -e '
    .status == "ready" and
    .notifications.configured == true and
    .notifications.recovery == "ok" and
    .notifications.consecutive_failures == 0
  ' <<<"$readiness" >/dev/null; then
    recovered=true
    break
  fi
  sleep 2
done
if ! $recovered; then
  docker logs mdbase-provider-upgrade-candidate
  printf 'Candidate provider did not recover upgraded notification state.\n' >&2
  exit 1
fi

upgrade_phase 'finalizing candidate admission after recovery readiness'
for admission_step in \
  'open-hosted-query-admission-provisional.sql:lease_seconds=180' \
  'finalize-hosted-query-admission.sql:'
do
  admission_file=${admission_step%%:*}
  admission_variable=${admission_step#*:}
  admission_arguments=(
    --host 127.0.0.1 --port "$UPGRADE_DATABASE_PORT"
    --username mdbase --dbname mdbase_provider_upgrade
    --set ON_ERROR_STOP=1 --set "fence_token=$CUTOVER_OWNER_TOKEN"
  )
  if [[ -n $admission_variable ]]; then
    admission_arguments+=(--set "$admission_variable")
  fi
  docker run --rm --network host \
    --env PGPASSWORD=previous-provider-upgrade \
    --entrypoint psql \
    "$CANDIDATE_IMAGE" \
    "${admission_arguments[@]}" \
    --file "/usr/local/share/mdbase-connect/postgres/$admission_file" \
    >/dev/null
done

contract=$(query_notification_contract true)
printf 'Recovered notification contract: %s\n' "$contract"
[[ $contract == "mdbase.runtime.timer.fired|1.0.0|sha256:41105be7a7abf33b31ced47e1e1965242236e40ccaea286b959b0a8c591f5642" ]]
connect_contracts=$(query_connect_contracts)
printf 'Recovered Connect compatibility contracts: %s\n' "$connect_contracts"
[[ $connect_contracts == "3|5|1|1" ]]
application_binding=$(query_notification_application_binding)
printf 'Recovered legacy application binding: %s\n' "$application_binding"
[[ $application_binding == "legacy.unbound.33333333333343338333333333333333|sha256:$(printf '0%.0s' {1..64})" ]]

canonical_inventory_after_recovery=$(query_canonical_authority_inventory)
printf 'Recovered candidate canonical authority inventory: sha256:%s\n' \
  "$canonical_inventory_after_recovery"
[[ $canonical_inventory_after_recovery == "$canonical_inventory_before" ]]

if ! replayed_receipt=$(provider_json POST \
  "/v1/authorities/$UPGRADE_COLLECTION_ID/sync/mutations" \
  "$(previous_mutation_body)" "$UPGRADE_REPLICA_TOKEN"); then
  printf 'Beta69 receipt replay failed: %s\n' "$replayed_receipt" >&2
  exit 1
fi
printf 'Replayed beta69 receipt: %s\n' "$replayed_receipt"
jq -e '
  .status == "applied" and
  .record.path == "upgrade/receipt.md" and
  .record.document == "---\ntitle: Preserved beta receipt\n---\n\nExact beta69 bytes.\n"
' <<<"$replayed_receipt" >/dev/null
canonical_inventory_after_replay=$(query_canonical_authority_inventory)
printf 'Replayed candidate canonical authority inventory: sha256:%s\n' \
  "$canonical_inventory_after_replay"
[[ $canonical_inventory_after_replay == "$canonical_inventory_before" ]]

if ! exact_receipt=$(provider_json POST \
  "/v1/authorities/$UPGRADE_COLLECTION_ID/sync/mutations" \
  "$(exact_mutation_body "$previous_revision")" "$UPGRADE_REPLICA_TOKEN"); then
  printf 'Candidate exact mutation failed: %s\n' "$exact_receipt" >&2
  exit 1
fi
printf 'Candidate exact mutation receipt: %s\n' "$exact_receipt"
jq -e '
  .status == "applied" and
  .record.path == "upgrade/receipt.md" and
  .record.document == "---\ntitle: Exact beta receipt\n---\n\nExact bytes.\n"
