upgrade_phase 'applying candidate migrations'
docker run --rm --network host \
  --env DATABASE_URL \
  "$CANDIDATE_IMAGE" \
  node services/server/dist/migrate.js
# The transactional retirement is intentionally safe to run again.
docker run --rm --network host \
  --env DATABASE_URL \
  "$CANDIDATE_IMAGE" \
  node services/server/dist/migrate.js

docker run --rm --interactive --network host \
  --env DATABASE_URL \
  "$CANDIDATE_IMAGE" \
  node --input-type=module <<'NODE'
import assert from "node:assert/strict";
import { createDatabase } from "/app/services/server/dist/db.js";

const db = await createDatabase(process.env.DATABASE_URL);
try {
  const state = await db.query(`
    SELECT
      count(*) FILTER (
        WHERE id IN (
          'dddddddd-dddd-4ddd-8ddd-dddddddddddd',
          'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',
          'ffffffff-ffff-4fff-8fff-ffffffffffff'
        )
        AND revoked_at IS NOT NULL
        AND reauthorization_required_at IS NOT NULL
        AND reauthorization_reason = 'collection_level_authorization'
      )::int AS retired_grants,
      count(*) FILTER (
        WHERE id = '99999999-9999-4999-8999-999999999999'
          AND revoked_at IS NULL
      )::int AS canonical_grants
    FROM grants
  `);
  assert.deepEqual(state.rows[0], { retired_grants: 3, canonical_grants: 1 });

  const tokens = await db.query(`
    SELECT
      count(*) FILTER (
        WHERE grant_id <> '99999999-9999-4999-8999-999999999999'
          AND revoked_at IS NOT NULL
      )::int AS retired,
      count(*) FILTER (
        WHERE grant_id = '99999999-9999-4999-8999-999999999999'
          AND revoked_at IS NULL
      )::int AS canonical
    FROM (
      SELECT grant_id, revoked_at FROM access_tokens
      UNION ALL
      SELECT grant_id, revoked_at FROM refresh_tokens
    ) authority_tokens
    WHERE grant_id IN (
      'dddddddd-dddd-4ddd-8ddd-dddddddddddd',
      'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',
      'ffffffff-ffff-4fff-8fff-ffffffffffff',
      '99999999-9999-4999-8999-999999999999'
    )
  `);
  assert.deepEqual(tokens.rows[0], { retired: 6, canonical: 2 });

  const replicas = await db.query(`
    SELECT
      count(*) FILTER (
        WHERE id IN (
          'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
          'abababab-abab-4bab-8bab-abababababab',
          'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
        )
        AND revoked_at IS NOT NULL
        AND token_hash IS NULL
      )::int AS retired,
      count(*) FILTER (
        WHERE id = 'cccccccc-cccc-4ccc-8ccc-cccccccccccc'
          AND revoked_at IS NULL
          AND token_hash = 'canonical-token'
      )::int AS canonical
    FROM hosted_replicas
  `);
  assert.deepEqual(replicas.rows[0], { retired: 3, canonical: 1 });

  const jobs = await db.query(`
    SELECT grant_id, replica_id
    FROM provider_revocation_jobs
    WHERE replica_id IN (
      'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
      'abababab-abab-4bab-8bab-abababababab',
      'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
    )
    ORDER BY replica_id
  `);
  assert.deepEqual(jobs.rows, [
    {
      grant_id: 'dddddddd-dddd-4ddd-8ddd-dddddddddddd',
      replica_id: 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
    },
    {
      grant_id: 'ffffffff-ffff-4fff-8fff-ffffffffffff',
      replica_id: 'abababab-abab-4bab-8bab-abababababab'
    },
    {
      grant_id: 'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee',
      replica_id: 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
    }
  ]);
} finally {
  await db.end();
}
