[Unit]
Description=Synthetic production app timings
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=RUNNER_USER
WorkingDirectory=/opt/app-timings
UMask=0077
ExecStart=/usr/bin/node /opt/app-timings/run.mjs /opt/app-timings/config.json
TimeoutStartSec=40min
ExecStopPost=+/usr/sbin/poweroff

[Install]
WantedBy=multi-user.target
