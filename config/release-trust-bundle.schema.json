{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/schemas/release-trust-bundle/v1",
  "title": "Authenticated release-linked NEXT trust inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "repository", "commit", "version", "imageBundle", "publication", "qualification", "trustAssets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "mdbase-release-trust-bundle"},
    "repository": {"const": "mdbase-dev/mdbase-connect"},
    "commit": {"$ref": "#/$defs/commit"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z.-]+$"},
    "imageBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "length", "sha256", "publicationRunId", "publicationRunAttempt"],
      "properties": {
        "path": {"const": "image-release-bundle.json"},
        "length": {"$ref": "#/$defs/length"},
        "sha256": {"$ref": "#/$defs/digest"},
        "publicationRunId": {"$ref": "#/$defs/positive"},
        "publicationRunAttempt": {"$ref": "#/$defs/positive"}
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "runId", "runAttempt", "publisherCommit"],
      "properties": {
        "workflow": {"const": "publish-images.yml"},
        "runId": {"$ref": "#/$defs/positive"},
        "runAttempt": {"$ref": "#/$defs/positive"},
        "publisherCommit": {"$ref": "#/$defs/commit"}
      }
    },
    "qualification": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "runId", "runAttempt"],
      "properties": {
        "workflow": {"const": "server-ci.yml"},
        "runId": {"$ref": "#/$defs/positive"},
        "runAttempt": {"$ref": "#/$defs/positive"}
      }
    },
    "trustAssets": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "length", "sha256", "environment", "controlPlaneOrigin", "logOrigin", "source"],
        "properties": {
          "path": {"const": "next-trust/lab.json"},
          "length": {"$ref": "#/$defs/length"},
          "sha256": {"$ref": "#/$defs/digest"},
          "environment": {"const": "lab"},
          "controlPlaneOrigin": {"type": "string", "format": "uri"},
          "logOrigin": {"type": "string", "format": "uri"},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["repository", "commit", "version"],
            "properties": {
              "repository": {"const": "mdbase-dev/mdbase-connect"},
              "commit": {"$ref": "#/$defs/commit"},
              "version": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "length": {"type": "integer", "minimum": 1, "maximum": 65536},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
