{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/schemas/release-components/v2",
  "title": "mdbase product release component contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "publication", "sdkPublication", "sourceDependencies", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "sdkPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "ready", "productionRegistry", "prerelease", "environments"],
      "properties": {
        "workflow": { "const": "publish-sdk-npm.yml" },
        "ready": { "type": "boolean" },
        "productionRegistry": { "const": "https://registry.npmjs.org/" },
        "prerelease": {
          "const": {
            "tagPrefix": "sdk-v",
            "assets": { "staging": "sdk-staging.tgz", "lab": "sdk-lab.tgz" }
          }
        },
        "environments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["production", "staging", "lab"],
          "properties": {
            "production": { "$ref": "#/$defs/sdkEnvironment" },
            "staging": { "$ref": "#/$defs/sdkEnvironment" },
            "lab": { "$ref": "#/$defs/sdkEnvironment" }
          }
        }
      }
    },
    "repository": { "const": "mdbase-dev/mdbase-connect" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "artifactName", "certificateIdentity", "certificateIssuer"],
      "properties": {
        "workflow": { "const": "publish-images.yml" },
        "artifactName": { "const": "release-bundle" },
        "certificateIdentity": { "type": "string", "pattern": "^https://github\\.com/" },
        "certificateIssuer": { "const": "https://token.actions.githubusercontent.com" }
      }
    },
    "sourceDependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revisionFile"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "revisionFile": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "kind", "image", "dockerfile", "context", "platform", "attestationType"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "required": { "type": "boolean" },
          "kind": { "const": "oci-image" },
          "image": { "type": "string", "pattern": "^ghcr\\.io/mdbase-dev/[a-z0-9-]+$" },
          "dockerfile": { "type": "string", "pattern": "^deploy/docker/Dockerfile\\.[A-Za-z0-9-]+$" },
          "context": { "const": "." },
          "platform": { "const": "linux/amd64" },
          "attestationType": { "const": "https://mdbase.dev/attestations/release-image/v1" }
        }
      }
    }
  },
  "$defs": {
    "sdkEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "sha256", "bytes", "cpOrigin", "logOrigin", "sourceCommit", "sourceVersion"],
      "properties": {
        "package": { "enum": ["@mdbase-dev/sdk", "@mdbase-dev/sdk-staging", "@mdbase-dev/sdk-lab"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "cpOrigin": { "type": "string", "pattern": "^https://" },
        "logOrigin": { "type": "string", "pattern": "^https://" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    }
  }
}
