{
  "name": "mdbase",
  "version": "0.5.0-rc.1",
  "description": "The mdbase engine for JavaScript: contract digests, JSON Schema, catalog loading and type packs everywhere; collections on Node.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdbase-dev/mdbase-connect",
    "directory": "runtime/packages/mdbase"
  },
  "homepage": "https://mdbase.dev",
  "keywords": [
    "mdbase",
    "markdown",
    "frontmatter",
    "json-schema",
    "notes"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm/mdbase-core.wasm": "./wasm/mdbase-core.wasm",
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "wasm",
    "native",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:native": "node scripts/build-native.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@callumalpass/mdbase": "0.3.0-rc.9",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "js-yaml": "4.1.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
