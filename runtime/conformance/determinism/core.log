{op: cel, expression: "meta.?owner.orValue('nobody') + '/' + meta.?team.orValue('none')", record: {meta: {owner: ann}}}
{op: cel, expression: "[3, 1, 2].map(v, v > 1, v * 10) + [1, 2, 3].filter(v, v % 2 == 1)", record: {}}
{op: cel, expression: "{'b': 1, 'a': 2}.map(k, k)", record: {}}
