{op: cel, expression: "'é'.matches('^\\\\w$')", record: {}}
{op: cel, expression: "title.matches('\\\\p{L}')", record: {title: x}}
{op: cel, expression: "now()", record: {}}

# CEL temporal values (spec 10). No clock or zone is bound in replay, so now(),
